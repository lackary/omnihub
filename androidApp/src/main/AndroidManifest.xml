<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:name=".OmniHubApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OmniHub">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OmniHub"
            android:launchMode="singleTask">
            <property
                android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
                android:value="XR_ACTIVITY_START_MODE_HOME_SPACE_MANAGED" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="omnihub" />
                <data android:host="auth" />
                <data android:pathPrefix="/callback" />
            </intent-filter>
        </activity>
        <activity
                android:name=".PhotoStackActivity"
                android:exported="false"
                android:theme="@style/Theme.OmniHub"
                android:resizeableActivity="true">
            <property
                    android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
                    android:value="XR_ACTIVITY_START_MODE_HOME_SPACE_MANAGED" />
            <layout
                    android:defaultWidth="800dp"
                    android:defaultHeight="1000dp"
                    android:gravity="end" />
        </activity>
        <activity
                android:name=".UserDetailActivity"
                android:exported="false"
                android:theme="@style/Theme.OmniHub"
                android:resizeableActivity="true">
            <property
                    android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
                    android:value="XR_ACTIVITY_START_MODE_HOME_SPACE_MANAGED" />
            <layout
                    android:defaultWidth="800dp"
                    android:defaultHeight="1000dp"
                    android:gravity="start" />
        </activity>
    </application>

</manifest>
